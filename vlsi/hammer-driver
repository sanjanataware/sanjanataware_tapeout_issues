#!/usr/bin/env python3
#
# NOTE: the custom hooks are only used for sky130.

import os

from hammer.vlsi import CLIDriver, HammerTool, HammerToolHookAction

from typing import Dict, Callable, Optional, List

from hammer.technology.sky130 import SKY130Tech
from hammer.tech import Corner, Supplies, Provide, Library, ExtraLibrary
from hammer.vlsi import MMMCCornerType
from hammer.technology.sky130.sram_compiler import SKY130SRAMGenerator

