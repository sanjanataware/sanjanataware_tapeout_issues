class ExampleDriver(CLIDriver):
    def get_extra_par_hooks(self) -> List[HammerToolHookAction]:
        extra_hooks = [
            # Default set of steps can be found in the CAD tool plugin's __init__.py

            # make_pre_insertion_hook will execute the custom hook before the specified step
            # SYNTAX: make_pre_insertion_hook("EXISTING_STEP", INSERTED_HOOK)
            # HammerTool.make_pre_insertion_hook("route_design", example_add_fillers),

            # make_post_insertion_hook will execute the custom hook after the specified step
            # HammerTool.make_post_insertion_hook("init_design", example_tool_settings),
            HammerTool.make_post_insertion_hook("write_design", example_report_area),

            # make_replacement_hook will replace the specified step with a custom hook
            # HammerTool.make_replacement_hook("place_tap_cells", example_place_tap_cells),

            # make_removal_hook will remove the specified step from the flow
            HammerTool.make_removal_hook("place_bumps"),

            # The target step in any of the above calls may be a default step or another one of your custom hooks
        ]
        return extra_hooks

if __name__ == '__main__':
    try:
        # Save the original method
        orig_setup_verilog = SKY130Tech.setup_verilog
        orig_setup_io_lefs = SKY130Tech.setup_io_lefs
        orig_generate_sram = SKY130SRAMGenerator.generate_sram
        
        def patched_setup_verilog(self):
            try:
                orig_setup_verilog(self)
            except IndexError:
                # Catch the crash caused by the missing buggy specify block
                self.logger.warning("Caught IndexError in SKY130Tech.setup_verilog. The PDK specify block bug appears to already be fixed, continuing.")
                pass

        def patched_setup_io_lefs(self):
            try:
                orig_setup_io_lefs(self)
            except IndexError:
                # Catch the crash caused by the missing buggy io lef macros
                self.logger.warning("Caught IndexError in SKY130Tech.setup_io_lefs. The PDK IO LEF bug appears to already be fixed, continuing.")
                pass

        def patched_generate_sram(self, params, corner):
            if not params.name.startswith("sram22"):
                return orig_generate_sram(self, params, corner)

            if params.family != "1rw" and params.family != "1rw1r":
                self.logger.error("SKY130 SRAM cache does not support family:{f}".format(f=params.family))
                return ExtraLibrary(prefix=None, library=None)  # type: ignore

            speed_name: Optional[str] = None
            corner_str: Optional[str] = None
            if corner.type == MMMCCornerType.Setup:
                speed_name = "slow"
                corner_str = "ss_100C_1v60"
            elif corner.type == MMMCCornerType.Hold:
                speed_name = "fast"
                corner_str = "ff_n40C_1v95"
            elif corner.type == MMMCCornerType.Extra:
                speed_name = "typical"
                corner_str = "tt_025C_1v80"

            sram_name = params.name
            base_dir = self.get_setting('technology.sky130.sram22_sky130_macros')
            macro_dir = os.path.join(base_dir, sram_name)
            assert speed_name is not None
            assert corner_str is not None

            lib_path: Optional[str] = None
            found = False
            for fidelity in [".rcc", ".rc", ".c", ""]:
                candidate = os.path.join(macro_dir, f"{sram_name}_{corner_str}{fidelity}.lib")
                if os.path.exists(candidate):
                    lib_path = candidate
                    found = True
                    break
                else:
                    self.logger.warning(f"SKY130 {params.name} SRAM cache does not support corner {corner_str} with {fidelity} extraction")

            if not found or lib_path is None:
                self.logger.error(f"SKY130 {params.name} SRAM cache does not support corner {corner_str}")

            return ExtraLibrary(prefix=None, library=Library(
                name=sram_name,
                nldm_liberty_file=lib_path,
                lef_file=os.path.join(macro_dir, f"{sram_name}.lef"),
                gds_file=os.path.join(macro_dir, f"{sram_name}.gds"),
                spice_file=os.path.join(macro_dir, f"{sram_name}.spice"),
                verilog_sim=os.path.join(macro_dir, f"{sram_name}.v"),
                corner=Corner(nmos=speed_name, pmos=speed_name, temperature=str(corner.temp.value_in_units("C")) + " C"),
                supplies=Supplies(VDD=str(corner.voltage.value_in_units("V")) + " V", GND="0 V"),
                provides=[Provide(lib_type="sram", vt=params.vt)]))
                
        # Apply the patches
        SKY130Tech.setup_verilog = patched_setup_verilog
        SKY130Tech.setup_io_lefs = patched_setup_io_lefs
        SKY130SRAMGenerator.generate_sram = patched_generate_sram
    except Exception as e:
        print("Warning: Failed to monkey-patch sky130 technology plugin:", e)

    ExampleDriver().main()
